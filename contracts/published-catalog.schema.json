{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/published-catalog.schema.json",
  "title": "Published Catalog Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "valid_until", "products", "tenant_scopes"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["public_id", "title", "availability_band"],
        "properties": {
          "public_id": {"type": "string", "pattern": "^[A-Za-z0-9]{22}$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]{1,100}$"},
          "title": {"type": "string"}, "description": {"type": "string"}, "category": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "images": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["url"],"properties":{"url":{"type":"string","format":"uri"},"alt":{"type":"string"}}}},
          "attributes": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
          "price": {"type":"object","additionalProperties":false,"required":["amount","currency"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"tier":{"type":"string"}}},
          "availability_band": {"enum": ["in_stock", "low", "out_of_stock"]},
          "lead_time_days": {"type": "integer", "minimum": 0}, "as_of": {"type": "string", "format": "date-time"},
          "source": {"type": "string"}, "purchasable": {"type": "boolean"}
        }
      }
    },
    "tenant_scopes": {"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["product_ids","price_tier","allow_full_enumeration"],"properties":{"product_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Za-z0-9]{22}$"}},"price_tier":{"type":"string"},"allow_full_enumeration":{"type":"boolean"}}}}
  }
}
