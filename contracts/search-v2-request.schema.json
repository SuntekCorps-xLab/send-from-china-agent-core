{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/search-v2-request.schema.json",
  "title": "Search Contract v2 Request",
  "description": "A product-first search request that separates retrieval identity, explicit hard constraints, soft ranking context, and transaction context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "product_identity",
    "hard_constraints",
    "soft_context",
    "transaction_context",
    "limit"
  ],
  "properties": {
    "contract_version": { "const": "2.0" },
    "product_identity": {
      "allOf": [
        { "$ref": "#/$defs/condition" },
        {
          "type": "object",
          "properties": {
            "name": { "const": "product_identity" },
            "value": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
            "scope": { "const": "product" },
            "hardness": { "const": "hard" }
          }
        }
      ]
    },
    "hard_constraints": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/condition" },
          {
            "type": "object",
            "properties": {
              "name": { "enum": ["price_min", "price_max", "material", "color", "must_have", "exclude"] },
              "source": { "const": "explicit" },
              "scope": { "const": "product" },
              "hardness": { "const": "hard" }
            }
          },
          {
            "if": {
              "properties": { "name": { "enum": ["price_min", "price_max"] } },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "value": { "type": "number", "minimum": 0 }
              }
            }
          },
          {
            "if": {
              "properties": { "name": { "enum": ["material", "color", "must_have", "exclude"] } },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "value": { "$ref": "#/$defs/textCriterionValue" }
              }
            }
          }
        ]
      }
    },
    "soft_context": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/condition" },
          {
            "type": "object",
            "properties": {
              "scope": { "enum": ["product", "session"] },
              "hardness": { "enum": ["soft", "informational"] }
            }
          }
        ]
      }
    },
    "transaction_context": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/condition" },
          {
            "type": "object",
            "properties": {
              "name": { "enum": ["ship_to", "quantity", "delivery_days_max"] },
              "scope": { "const": "transaction" },
              "hardness": { "enum": ["hard", "informational"] }
            }
          },
          {
            "if": {
              "properties": { "hardness": { "const": "hard" } },
              "required": ["hardness"]
            },
            "then": { "properties": { "source": { "const": "explicit" } } }
          },
          {
            "if": {
              "properties": { "name": { "const": "ship_to" } },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "value": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "\\S" }
              }
            }
          },
          {
            "if": {
              "properties": { "name": { "const": "quantity" } },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "value": { "type": "integer", "minimum": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "name": { "const": "delivery_days_max" } },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "value": { "type": "integer", "minimum": 1 }
              }
            }
          }
        ]
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
    "cursor": { "type": ["string", "null"], "maxLength": 1000, "default": null }
  },
  "$defs": {
    "textCriterionValue": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "source", "scope", "hardness"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "value": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            }
          ]
        },
        "source": { "enum": ["explicit", "inferred", "default"] },
        "scope": { "enum": ["product", "session", "transaction"] },
        "hardness": { "enum": ["hard", "soft", "informational"] }
      }
    }
  }
}
