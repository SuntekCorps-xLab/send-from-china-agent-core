{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/send-from-china-product.json",
  "title": "Send From China normalized product",
  "type": "object",
  "required": ["source_id", "title", "description_html", "images", "variants"],
  "properties": {
    "source_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 3, "maxLength": 255 },
    "description_html": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": { "url": { "type": "string", "format": "uri" } },
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "price"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 100 },
          "price": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
