{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/send-from-china/evals/private-score/runtime-manifest.schema.json",
  "title": "Private search score runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "environment",
    "release",
    "capture_runner",
    "measurement",
    "quality_capture",
    "latency_baseline_capture",
    "datasets",
    "pool",
    "surface_adapters",
    "models",
    "packets",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "send-from-china-private-runtime-manifest/v1"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[2-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
    "environment": {"const": "isolated_shadow"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mini_suntek_commit",
        "agent_core_commit",
        "agent_core_search_contract_sha256",
        "reference_store_commit",
        "root_worker_commit",
        "root_worker_working_tree_dirty"
      ],
      "properties": {
        "mini_suntek_commit": {"$ref": "#/$defs/commit"},
        "agent_core_commit": {"$ref": "#/$defs/commit"},
        "agent_core_search_contract_sha256": {"$ref": "#/$defs/sha256"},
        "reference_store_commit": {"$ref": "#/$defs/commit"},
        "root_worker_commit": {"$ref": "#/$defs/commit"},
        "root_worker_working_tree_dirty": {"const": false}
      }
    },
    "capture_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_requests_per_surface",
        "warmups_excluded_from_metrics",
        "measured_attempts_per_case",
        "schedule",
        "schedule_seed_sha256",
        "maximum_arm_capture_skew_seconds",
        "timeout_ms",
        "timeout_samples_retained",
        "clock"
      ],
      "properties": {
        "warmup_requests_per_surface": {"type": "integer", "minimum": 1, "maximum": 100},
        "warmups_excluded_from_metrics": {"const": true},
        "measured_attempts_per_case": {"const": 1},
        "schedule": {"const": "seeded_arm_interleave"},
        "schedule_seed_sha256": {"$ref": "#/$defs/sha256"},
        "maximum_arm_capture_skew_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "timeout_ms": {"const": 5000},
        "timeout_samples_retained": {"const": true},
        "clock": {"const": "monotonic"}
      }
    },
    "quality_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "deployment_config_sha256",
        "catalog_snapshot_sha256",
        "index_snapshot_sha256",
        "tenant_policy_sha256",
        "deployed_field_policy_sha256",
        "scorer_required_allowlist_sha256",
        "hard_constraint_evaluator_sha256",
        "request_packet_sha256",
        "candidate_retrieval_recipe_sha256",
        "authoritative_selector",
        "shadow_selector"
      ],
      "properties": {
        "deployment_id": {"$ref": "#/$defs/opaqueId"},
        "deployment_config_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_policy_sha256": {"$ref": "#/$defs/sha256"},
        "deployed_field_policy_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_required_allowlist_sha256": {"$ref": "#/$defs/sha256"},
        "hard_constraint_evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "request_packet_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_retrieval_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "authoritative_selector": {"const": "legacy"},
        "shadow_selector": {"enum": ["rrf", "rrf_reranker"]}
      }
    },
    "latency_baseline_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "deployment_config_sha256",
        "catalog_snapshot_sha256",
        "index_snapshot_sha256",
        "tenant_policy_sha256",
        "request_packet_sha256",
        "fusion_mode",
        "rerank_mode",
        "evidence_rag_mode"
      ],
      "properties": {
        "deployment_id": {"$ref": "#/$defs/opaqueId"},
        "deployment_config_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_policy_sha256": {"$ref": "#/$defs/sha256"},
        "request_packet_sha256": {"$ref": "#/$defs/sha256"},
        "fusion_mode": {"const": "legacy"},
        "rerank_mode": {"const": "off"},
        "evidence_rag_mode": {"const": "off"}
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_canonical_sha256",
        "provisional_canonical_sha256",
        "holdout_canonical_sha256",
        "agreement_artifact_sha256"
      ],
      "properties": {
        "core_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "provisional_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "holdout_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "agreement_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_recipe_version",
        "pool_recipe_sha256",
        "pool_manifest_sha256"
      ],
      "properties": {
        "pool_recipe_version": {"$ref": "#/$defs/version"},
        "pool_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "pool_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "surface_adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "mcp", "chat", "storefront"],
      "properties": {
        "http": {"$ref": "#/$defs/adapter"},
        "mcp": {"$ref": "#/$defs/adapter"},
        "chat": {"$ref": "#/$defs/adapter"},
        "storefront": {"$ref": "#/$defs/adapter"}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/model"}
    },
    "packets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_packet_sha256",
        "agent_task_packet_sha256",
        "adversarial_packet_sha256"
      ],
      "properties": {
        "query_packet_sha256": {"$ref": "#/$defs/sha256"},
        "agent_task_packet_sha256": {"$ref": "#/$defs/sha256"},
        "adversarial_packet_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_writes_enabled",
        "live_invites_activated",
        "raw_query_logging_enabled",
        "retry_policy"
      ],
      "properties": {
        "production_writes_enabled": {"const": false},
        "live_invites_activated": {"const": false},
        "raw_query_logging_enabled": {"const": false},
        "retry_policy": {"const": "none"}
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "models": {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {"role": {"const": "embedding"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "models": {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {"role": {"const": "reranker"}}
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "models": {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {"role": {"const": "intent"}}
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "quality_capture": {
            "type": "object",
            "required": ["shadow_selector"],
            "properties": {"shadow_selector": {"const": "rrf_reranker"}}
          }
        },
        "required": ["quality_capture"]
      },
      "then": {
        "properties": {
          "models": {
            "contains": {
              "type": "object",
              "required": ["role"],
              "properties": {"role": {"const": "reranker"}}
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,79}$"},
    "modelIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9._:@/+\\-]{0,199}$"},
    "opaqueId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{31,127}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_sha256", "transport_profile", "transport_contract_sha256", "targets"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "transport_profile": {
          "enum": ["search_v2_http", "mcp_jsonrpc_tools_call", "mini_chat_bff", "reference_storefront_bff"]
        },
        "transport_contract_sha256": {"$ref": "#/$defs/sha256"},
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["legacy", "candidate"],
          "properties": {
            "legacy": {"$ref": "#/$defs/target"},
            "candidate": {"$ref": "#/$defs/target"}
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "deployment_id",
        "config_sha256",
        "upstream_core_deployment_id_sha256",
        "upstream_core_config_sha256",
        "routing_receipt_sha256"
      ],
      "properties": {
        "kind": {"enum": ["direct_core", "bff"]},
        "deployment_id": {"$ref": "#/$defs/opaqueId"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_core_deployment_id_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_core_config_sha256": {"$ref": "#/$defs/sha256"},
        "routing_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider_model_id", "revision", "config_sha256"],
      "properties": {
        "role": {"enum": ["embedding", "reranker", "intent"]},
        "provider_model_id": {"$ref": "#/$defs/modelIdentifier"},
        "revision": {"$ref": "#/$defs/modelIdentifier"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
