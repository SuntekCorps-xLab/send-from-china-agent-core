{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/send-from-china/evals/private-score/pool.schema.json",
  "title": "Private search judgment pool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "pool_recipe_version",
    "recipe",
    "datasets",
    "cases",
    "fingerprints",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": "send-from-china-private-pool/v1"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[2-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
    "pool_recipe_version": {"$ref": "#/$defs/version"},
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_before_annotation",
        "candidate_config_frozen_before_pool",
        "blinded_source_and_rank",
        "dedupe_key",
        "max_candidates_per_case",
        "presentation_seed_sha256",
        "sources"
      ],
      "properties": {
        "frozen_before_annotation": {"const": true},
        "candidate_config_frozen_before_pool": {"const": true},
        "blinded_source_and_rank": {"const": true},
        "dedupe_key": {"const": "public_id"},
        "max_candidates_per_case": {"const": 500},
        "presentation_seed_sha256": {"$ref": "#/$defs/sha256"},
        "sources": {
          "type": "array",
          "minItems": 7,
          "items": {"$ref": "#/$defs/source"},
          "allOf": [
            {"contains": {"type": "object", "properties": {"lane": {"const": "legacy"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "meili_lexical"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "bge_vector"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "alias"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "shopify_fallback"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "known_positive"}}, "required": ["lane"]}, "minContains": 1},
            {"contains": {"type": "object", "properties": {"lane": {"const": "approved_negative"}}, "required": ["lane"]}, "minContains": 1}
          ]
        }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_canonical_sha256", "provisional_canonical_sha256", "catalog_snapshot_sha256", "index_snapshot_sha256", "tenant_policy_sha256"],
      "properties": {
        "core_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "provisional_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/case"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {"dataset": {"const": "core"}},
            "required": ["dataset"]
          },
          "minContains": 120,
          "maxContains": 120
        },
        {
          "contains": {
            "type": "object",
            "properties": {"dataset": {"const": "provisional"}},
            "required": ["dataset"]
          },
          "minContains": 180,
          "maxContains": 180
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "priority_known_stock_rank": {"type": "integer", "minimum": 1, "maximum": 200}
            },
            "required": ["priority_known_stock_rank"]
          },
          "minContains": 200,
          "maxContains": 200
        }
      ]
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_candidate_universe_sha256",
        "provisional_candidate_universe_sha256"
      ],
      "properties": {
        "core_candidate_universe_sha256": {"$ref": "#/$defs/sha256"},
        "provisional_candidate_universe_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_positive_negative_receipt_sha256",
        "provisional_label_approval_sha256"
      ],
      "properties": {
        "known_positive_negative_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "provisional_label_approval_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,79}$"},
    "publicId": {"type": "string", "pattern": "^[A-Za-z0-9]{22}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "lane",
        "top_k",
        "config_sha256",
        "model_revision",
        "model_config_sha256",
        "model_identity_sha256",
        "index_revision_sha256"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/version"},
        "lane": {
          "enum": [
            "legacy",
            "meili_lexical",
            "bge_vector",
            "alias",
            "shopify_fallback",
            "known_positive",
            "approved_negative"
          ]
        },
        "top_k": {"type": "integer", "minimum": 1, "maximum": 500},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "model_revision": {"$ref": "#/$defs/version"},
        "model_config_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "model_identity_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "index_revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "dataset",
        "priority_known_stock_rank",
        "known_stock_evidence_sha256",
        "known_stock_evidence_catalog_snapshot_sha256",
        "candidate_ids",
        "forbidden_reason_labels"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "dataset": {"enum": ["core", "provisional"]},
        "priority_known_stock_rank": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 200},
            {"type": "null"}
          ]
        },
        "known_stock_evidence_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "known_stock_evidence_catalog_snapshot_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/publicId"}
        },
        "forbidden_reason_labels": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/forbiddenReason"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"priority_known_stock_rank": {"type": "integer"}},
            "required": ["priority_known_stock_rank"]
          },
          "then": {
            "properties": {"known_stock_evidence_sha256": {"$ref": "#/$defs/sha256"}}
          },
          "else": {
            "properties": {"known_stock_evidence_sha256": {"type": "null"}}
          }
        }
      ]
    },
    "forbiddenReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "reasons"],
      "properties": {
        "public_id": {"$ref": "#/$defs/publicId"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["accessory_mismatch", "tenant_scope", "other_policy"]}
        }
      }
    }
  }
}
