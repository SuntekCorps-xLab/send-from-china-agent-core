{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/send-from-china/evals/private-score/predictions.schema.json",
  "title": "Private black-box search prediction packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "arm",
    "capture_channel",
    "runtime_manifest_canonical_sha256",
    "runner",
    "bindings",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "send-from-china-private-predictions/v1"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[2-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
    "arm": {"enum": ["legacy", "candidate"]},
    "capture_channel": {"enum": ["authoritative_legacy", "shadow_candidate"]},
    "runtime_manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_canonical_sha256",
        "provisional_canonical_sha256",
        "deployment_id_sha256",
        "deployment_config_sha256",
        "catalog_snapshot_sha256",
        "index_snapshot_sha256",
        "tenant_policy_sha256",
        "query_packet_sha256",
        "pool_manifest_sha256"
      ],
      "properties": {
        "core_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "provisional_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_id_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_config_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_policy_sha256": {"$ref": "#/$defs/sha256"},
        "query_packet_sha256": {"$ref": "#/$defs/sha256"},
        "pool_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"arm": {"const": "legacy"}}, "required": ["arm"]},
      "then": {"properties": {"capture_channel": {"const": "authoritative_legacy"}}}
    },
    {
      "if": {"properties": {"arm": {"const": "candidate"}}, "required": ["arm"]},
      "then": {"properties": {"capture_channel": {"const": "shadow_candidate"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,79}$"},
    "publicId": {"type": "string", "pattern": "^[A-Za-z0-9]{22}$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "request_canonical_sha256",
        "tenant_scope_sha256",
        "surfaces"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "request_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_scope_sha256": {"$ref": "#/$defs/sha256"},
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "mcp", "chat", "storefront"],
          "properties": {
            "http": {"$ref": "#/$defs/surfaceResult"},
            "mcp": {"$ref": "#/$defs/surfaceResult"},
            "chat": {"$ref": "#/$defs/surfaceResult"},
            "storefront": {"$ref": "#/$defs/surfaceResult"}
          }
        }
      }
    },
    "surfaceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "adapter_source_sha256",
        "transport_profile",
        "transport_contract_sha256",
        "target_kind",
        "target_deployment_id_sha256",
        "target_config_sha256",
        "upstream_core_deployment_id_sha256",
        "upstream_core_config_sha256",
        "routing_receipt_sha256",
        "transport_contract_valid",
        "raw_transport_private_field_count",
        "raw_transport_sensitive_value_count",
        "request_canonical_sha256",
        "normalized_intent_sha256",
        "raw_response_sha256",
        "execution_state",
        "attempt_count",
        "source_state",
        "canonical_status",
        "results",
        "normalized_core_payload_json_pointers",
        "latency"
      ],
      "properties": {
        "adapter_version": {"$ref": "#/$defs/version"},
        "adapter_source_sha256": {"$ref": "#/$defs/sha256"},
        "transport_profile": {
          "enum": ["search_v2_http", "mcp_jsonrpc_tools_call", "mini_chat_bff", "reference_storefront_bff"]
        },
        "transport_contract_sha256": {"$ref": "#/$defs/sha256"},
        "target_kind": {"enum": ["direct_core", "bff"]},
        "target_deployment_id_sha256": {"$ref": "#/$defs/sha256"},
        "target_config_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_core_deployment_id_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_core_config_sha256": {"$ref": "#/$defs/sha256"},
        "routing_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "transport_contract_valid": {"const": true},
        "raw_transport_private_field_count": {"const": 0},
        "raw_transport_sensitive_value_count": {"const": 0},
        "request_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_intent_sha256": {"$ref": "#/$defs/sha256"},
        "raw_response_sha256": {"$ref": "#/$defs/sha256"},
        "execution_state": {"enum": ["ok", "timeout", "transport_error", "contract_error"]},
        "attempt_count": {"const": 1},
        "source_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_status",
            "plan_complete",
            "scope_exhausted",
            "scan_limit_reached",
            "degraded"
          ],
          "properties": {
            "raw_status": {"type": "string", "maxLength": 80},
            "plan_complete": {"type": "boolean"},
            "scope_exhausted": {"type": "boolean"},
            "scan_limit_reached": {"type": "boolean"},
            "degraded": {"type": "boolean"}
          }
        },
        "canonical_status": {"enum": ["results", "needs_clarification", "no_match", "degraded"]},
        "results": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/publicProduct"}
        },
        "normalized_core_payload_json_pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_to_end_ms", "retrieval_ms"],
          "properties": {
            "end_to_end_ms": {"type": "number", "minimum": 0, "maximum": 60000},
            "retrieval_ms": {"type": "number", "minimum": 0, "maximum": 60000}
          }
        }
      }
    },
    "publicProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "title", "availability_band"],
      "properties": {
        "public_id": {"$ref": "#/$defs/publicId"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]{1,100}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"},
        "description": {"type": "string", "maxLength": 5000},
        "category": {"type": "string", "maxLength": 200},
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": {"type": "string", "maxLength": 100}
        },
        "images": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
              "alt": {"type": "string", "maxLength": 300}
            }
          }
        },
        "attributes": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {"$ref": "../../contracts/public-product-attribute-policy.v1.json"},
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "maxLength": 300},
              {"type": "number"}
            ]
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "number", "minimum": 0},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "tier": {"type": "string", "maxLength": 80}
          }
        },
        "availability_band": {"enum": ["in_stock", "low", "out_of_stock"]},
        "lead_time_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "as_of": {"type": "string", "format": "date-time", "pattern": "^[2-9][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
        "purchasable": {"type": "boolean"}
      }
    }
  }
}
