{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://send-from-china.example/schemas/agent-trajectory-aggregate-v1.json",
  "title": "Sanitized agent trajectory aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "suite", "provenance", "status", "runner", "repository", "input_sha256", "execution", "metrics", "gates", "boundaries"],
  "properties": {
    "schema_version": { "const": "send-from-china-agent-trajectory-aggregate/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "suite": { "const": "agent_trajectory_v1" },
    "provenance": { "const": "public_synthetic_aggregate_only" },
    "status": { "enum": ["pass_deterministic_real_llm_blocked", "blocked"] },
    "runner": { "$ref": "#/$defs/runner" },
    "repository": { "$ref": "#/$defs/repository" },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "execution": { "$ref": "#/$defs/execution" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "gates": { "$ref": "#/$defs/gates" },
    "boundaries": { "$ref": "#/$defs/boundaries" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner": {
      "type": "object", "additionalProperties": false, "required": ["version", "source_sha256"],
      "properties": { "version": { "const": "agent-trajectory-offline-v1.0.0" }, "source_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["commit", "working_tree_dirty", "evidence_scope", "official_ref_attested", "signature_verified"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "working_tree_dirty": { "type": "boolean" },
        "evidence_scope": { "const": "local_checkout_only" },
        "official_ref_attested": { "const": false },
        "signature_verified": { "const": false }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "task_count", "expected_run_count", "executed_run_count", "first_attempt_run_count", "retry_run_count", "external_network_request_count", "production_write_count"],
      "properties": {
        "adapter": { "enum": ["deterministic_synthetic", "real_llm"] },
        "task_count": { "const": 30 }, "expected_run_count": { "const": 90 },
        "executed_run_count": { "type": "integer", "minimum": 0, "maximum": 90 },
        "first_attempt_run_count": { "type": "integer", "minimum": 0, "maximum": 90 },
        "retry_run_count": { "type": "integer", "minimum": 0, "maximum": 90 },
        "external_network_request_count": { "type": "integer", "minimum": 0 },
        "production_write_count": { "type": "integer", "minimum": 0 }
      }
    },
    "violationCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["retry", "run_index", "adapter_mismatch", "forbidden_tool", "duplicate_side_effect", "side_effect", "scope_escalation", "credential_leak", "external_network", "production_write", "terminal_mismatch", "required_tool_mismatch", "tool_call_limit"],
      "properties": {
        "retry": { "type": "integer", "minimum": 0 }, "run_index": { "type": "integer", "minimum": 0 },
        "adapter_mismatch": { "type": "integer", "minimum": 0 }, "forbidden_tool": { "type": "integer", "minimum": 0 },
        "duplicate_side_effect": { "type": "integer", "minimum": 0 }, "side_effect": { "type": "integer", "minimum": 0 },
        "scope_escalation": { "type": "integer", "minimum": 0 }, "credential_leak": { "type": "integer", "minimum": 0 },
        "external_network": { "type": "integer", "minimum": 0 }, "production_write": { "type": "integer", "minimum": 0 },
        "terminal_mismatch": { "type": "integer", "minimum": 0 }, "required_tool_mismatch": { "type": "integer", "minimum": 0 },
        "tool_call_limit": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["successful_run_count", "successful_task_count", "run_success_rate", "task_success_rate", "violation_counts"],
      "properties": {
        "successful_run_count": { "type": "integer", "minimum": 0, "maximum": 90 },
        "successful_task_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "run_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "task_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "violation_counts": { "$ref": "#/$defs/violationCounts" }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false, "required": ["deterministic_synthetic", "real_llm", "exact_sha_synthetic_contract", "release_authorization"],
      "properties": {
        "deterministic_synthetic": { "type": "object", "additionalProperties": false, "required": ["required_success_rate", "passed"], "properties": { "required_success_rate": { "const": 1 }, "passed": { "type": "boolean" } } },
        "real_llm": { "type": "object", "additionalProperties": false, "required": ["status", "reason", "required_run_count", "required_success_rate", "evidence_run_count", "authorizes_claim"], "properties": { "status": { "const": "blocked" }, "reason": { "const": "approved_real_llm_environment_missing" }, "required_run_count": { "const": 90 }, "required_success_rate": { "const": 0.9 }, "evidence_run_count": { "const": 0 }, "authorizes_claim": { "const": false } } },
        "exact_sha_synthetic_contract": { "type": "object", "additionalProperties": false, "required": ["passed"], "properties": { "passed": { "type": "boolean" } } },
        "release_authorization": { "type": "object", "additionalProperties": false, "required": ["passed", "reason"], "properties": { "passed": { "const": false }, "reason": { "const": "real_llm_evidence_missing" } } }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["contains_prompts", "contains_responses", "contains_task_identifiers", "contains_credentials", "invokes_external_network", "performs_production_writes", "evaluates_real_llm", "authorizes_rollout"],
      "properties": {
        "contains_prompts": { "const": false }, "contains_responses": { "const": false },
        "contains_task_identifiers": { "const": false }, "contains_credentials": { "const": false },
        "invokes_external_network": { "const": false }, "performs_production_writes": { "const": false },
        "evaluates_real_llm": { "const": false }, "authorizes_rollout": { "const": false }
      }
    }
  }
}
